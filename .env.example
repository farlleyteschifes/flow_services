# Conexão do MongoDB usada pelo backend. Nunca exponha este valor ao cliente.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.example.mongodb.net/flow_services
# Opcional quando o nome do banco já estiver definido na URI.
MONGODB_DB_NAME=flow_services

# Segredo da rota de criação administrativa.
ADMIN_SECRET=altere-este-segredo

# Segredo usado para assinar/invalidate sessões.
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio
